xGeometry x="400" y="192" width="1150" height="74" as="geometry"/></mxCell>
        <mxCell id="a1_2" value="writes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;strokeColor=#2563eb;" edge="1" parent="1" source="in1" target="tb1_2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="tb1_3" value="&lt;b&gt;audit_log_changes&lt;/b&gt; &lt;i style=&#x27;color:#b45309&#x27;&gt;(example)&lt;/i&gt;&lt;table style=&quot;border-collapse:collapse;font-size:10px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;id&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;audit_id&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;field_name&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;old_value&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;new_value&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;role&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;null&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;&amp;quot;teacher&amp;quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;grade_level&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;null&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;&amp;quot;Grade 1&amp;quot;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;spacingLeft=6;spacingTop=4;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="400" y="278" width="1150" height="94" as="geometry"/></mxCell>
        <mxCell id="a1_3" value="writes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;strokeColor=#2563eb;" edge="1" parent="1" source="in1" target="tb1_3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="in2" value="&lt;b&gt;2. Assign the teaching load&lt;/b&gt;&lt;br&gt;&lt;i&gt;Principal · Personnel → Edit&lt;/i&gt;&lt;br&gt;&lt;span style=&#x27;color:#1d4ed8&#x27;&gt;INPUT&lt;/span&gt;&lt;br&gt;&lt;b&gt;Subject-grade:&lt;/b&gt; English · Grade 1&lt;br&gt;&lt;b&gt;Subject-grade:&lt;/b&gt; Filipino · Grade 1&lt;br&gt;" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#eff6ff;strokeColor=#2563eb;dashed=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="tb2_0" value="&lt;b&gt;user_subjects&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:10px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;id&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;user_id&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;subject_id&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;grade_level_id&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;9&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;3 (English)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;9&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;4 (Filipino)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;spacingLeft=6;spacingTop=4;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="400" y="412" width="1150" height="94" as="geometry"/></mxCell>
