        <mxCell id="s-title" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;Sample relational data model — inputs and the rows they create&lt;/b&gt;&lt;br&gt;Steps 1–4 are Juan&#x27;s actual rows in the seeded database; rows marked (example) illustrate what the step writes." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="-50" width="1100" height="46" as="geometry"/></mxCell>
        <mxCell id="in1" value="&lt;b&gt;1. Create the account&lt;/b&gt;&lt;br&gt;&lt;i&gt;Principal · Personnel → Add User&lt;/i&gt;&lt;br&gt;&lt;span style=&#x27;color:#1d4ed8&#x27;&gt;INPUT&lt;/span&gt;&lt;br&gt;&lt;b&gt;Username:&lt;/b&gt; teacher2&lt;br&gt;&lt;b&gt;Password:&lt;/b&gt; ••••••••&lt;br&gt;&lt;b&gt;Name:&lt;/b&gt; Juan D. Santos&lt;br&gt;&lt;b&gt;Role:&lt;/b&gt; Teacher&lt;br&gt;&lt;b&gt;Grade level:&lt;/b&gt; Grade 1&lt;br&gt;" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#eff6ff;strokeColor=#2563eb;dashed=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="300" height="352" as="geometry"/></mxCell>
        <mxCell id="tb1_0" value="&lt;b&gt;users&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:10px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;id&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;username&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;password_hash&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;first_name&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;middle_name&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;last_name&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;role&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;grade_level_id&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;number_of_children&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;is_active&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;full_name (computed)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;9&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;teacher2&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;$2b$12$…&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;Juan&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;D.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;Santos&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;teacher&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;0&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;Juan D. Santos&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;spacingLeft=6;spacingTop=4;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="1150" height="74" as="geometry"/></mxCell>
        <mxCell id="a1_0" value="writes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;strokeColor=#2563eb;" edge="1" parent="1" source="in1" target="tb1_0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="tb1_1" value="&lt;b&gt;user_held_roles (view)&lt;/b&gt; &lt;i style=&#x27;color:#b45309&#x27;&gt;(no user_roles row: teacher is Juan&amp;#x27;s primary role)&lt;/i&gt;&lt;table style=&quot;border-collapse:collapse;font-size:10px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;user_id&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#eeeeee&quot;&gt;role&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;9&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px&quot;&gt;teacher&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;spacingLeft=6;spacingTop=4;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="400" y="106" width="1150" height="74" as="geometry"/></mxCell>
