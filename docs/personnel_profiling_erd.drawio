        <mxCell id="title" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;TaskNet — Personnel Profiling ERD&lt;/b&gt;&lt;br&gt;Third Normal Form · matches backend/database.py" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="-40" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;id (PK)&lt;/b&gt;&lt;/u&gt; primary key · &lt;i&gt;(FK table)&lt;/i&gt; foreign key · (UK) unique&lt;br&gt;Crow&#x27;s foot: |— exactly one · o— zero or one · &amp;lt; many&lt;br&gt;In 3NF: no lists or JSON in a column (keywords, checks and audit changes are rows), no stored derived values (full_name is computed)&lt;br&gt;View &lt;b&gt;user_held_roles&lt;/b&gt; = users.role ∪ user_roles: every role a person holds&lt;br&gt;Colors: blue account &amp;amp; roles · purple delegation · yellow education · green skills · orange certifications · grey audit" style="rounded=1;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#999999;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1690" y="680" width="600" height="120" as="geometry"/></mxCell>
