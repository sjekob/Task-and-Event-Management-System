# Copy to .env (git-ignored) and fill in. Read by docker-compose.yml.
#
# Signs login tokens for every service. Must be long, random and secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Email through Mailtrap (Email Testing → your inbox → SMTP). Leave MAIL_HOST empty to send no email.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=TaskNet <no-reply@tasknet.local>
# Where links in emails point (the web app).
APP_URL=http://localhost:5173
