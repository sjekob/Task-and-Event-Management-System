{
  "expo": {
    "name": "TaskNet",
    "slug": "tasknet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tasknet.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tasknet.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TaskNet checks that you are at the event venue when you Time In or Time Out, and lets you pin an event's venue."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TaskNet uses your photos to set your profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TaskNet uses the camera to scan event attendance QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "tasknet"
  }
}
