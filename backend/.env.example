# TaskNet backend configuration — copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets.

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# REQUIRED in production. If unset, a random key is generated at startup and all
# sessions are lost on restart. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Access-token lifetime in hours.
TOKEN_EXPIRE_HOURS=24

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call the API. Leave blank only for
# local dev (falls back to permissive, credentials disabled).
#   e.g. CORS_ALLOW_ORIGINS=https://app.tasknet.example,https://admin.tasknet.example
CORS_ALLOW_ORIGINS=

# ── Gateway rate limiting (per client IP) ─────────────────────────────────────
RATE_LIMIT_WINDOW=60     # seconds
RATE_LIMIT_MAX=600       # requests per window per IP

# ── File uploads ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=15

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to the shared sqlite file during the SQLAlchemy migration.
# Postgres:  DATABASE_URL=postgresql+psycopg2://tasknet:tasknet@postgres:5432/tasknet
#   Supabase: postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
#   Neon:     postgresql://<user>:<password>@<host>/tasknet?sslmode=require
DATABASE_URL=sqlite:///./tasknet.db
SQL_ECHO=0               # set 1 to log SQL (dev only)

# Postgres container credentials (docker-compose).
POSTGRES_USER=tasknet
POSTGRES_PASSWORD=tasknet
POSTGRES_DB=tasknet

# Legacy app secret (docker-compose default; override in prod).
SECRET_KEY=
