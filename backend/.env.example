# ─────────────────────────────────────────────────────────────────────────────
# TaskNet — Environment Variable Template
# Copy this file to .env and fill in each value.
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT Secret Key (REQUIRED) ─────────────────────────────────────────────────
# Used to sign and verify all authentication tokens.
# The application WILL NOT START if this is missing.
#
# Generate a strong key (run once):
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Rotate this key periodically (every 90 days recommended).
# Rotating invalidates all existing sessions — users will be logged out.
JWT_SECRET_KEY=

# ── Token Lifetime ────────────────────────────────────────────────────────────
# How long a JWT remains valid, in hours.
# Shorter = more secure. Default: 24 hours.
TOKEN_EXPIRE_HOURS=24

# ── CORS ──────────────────────────────────────────────────────────────────────
# Leave CORS_ORIGIN blank for local/LAN development — the API will accept
# requests from any origin (safe because auth uses JWT headers, not cookies).
#
# Set CORS_ORIGIN to your deployed domain in production, e.g.:
#   CORS_ORIGIN=https://tasknet.yourdomain.com
CORS_ORIGIN=

# ── HTTPS Enforcement ─────────────────────────────────────────────────────────
# Set to true in production to enable the Strict-Transport-Security header
# (forces all browsers to use HTTPS for 1 year).
# Leave false during local HTTP development.
HTTPS_ONLY=false

# ── File Upload Limits ────────────────────────────────────────────────────────
# Maximum file size accepted by upload endpoints, in megabytes.
# Default: 10 MB.
MAX_UPLOAD_MB=10

# ── Server Binding ────────────────────────────────────────────────────────────
# Host and port for the Uvicorn server (when running via __main__).
HOST=0.0.0.0
PORT=8000

# ── Database (optional) ───────────────────────────────────────────────────────
# PostgreSQL connection URL. If unset, the app falls back to SQLite (tasknet.db).
#
# Format:  postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Examples:
#   Local:    DATABASE_URL=postgresql://postgres:secret@localhost:5432/tasknet
#   Supabase: DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
#   Neon:     DATABASE_URL=postgresql://<user>:<password>@<host>/tasknet?sslmode=require
DATABASE_URL=
